{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Nexus Repository REST Assets Repositories API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Repositories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all repositories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{nexus_url}/service/rest/v1/repositories"
          },
          "docs": "List all repositories"
        },
        {
          "info": {
            "name": "List repository settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{nexus_url}/service/rest/v1/repositorySettings"
          },
          "docs": "List repository settings"
        }
      ]
    }
  ],
  "bundled": true
}