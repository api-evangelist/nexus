{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Nexus Repository REST Assets Security API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Security",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{nexus_url}/service/rest/v1/security/users"
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "List roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{nexus_url}/service/rest/v1/security/roles"
          },
          "docs": "List roles"
        }
      ]
    }
  ],
  "bundled": true
}