{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Nexus Repository REST Assets Status API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check Nexus health status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{nexus_url}/service/rest/v1/status"
          },
          "docs": "Check Nexus health status"
        }
      ]
    }
  ],
  "bundled": true
}